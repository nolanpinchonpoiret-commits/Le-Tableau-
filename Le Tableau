<style>
:root{--board:#244b3e;--dark:#102a22;--chalk:#fff8df;--gold:#efd88a;--green:#38a85b;--red:#c95050}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#10251e;color:var(--chalk);font-family:Trebuchet MS,system-ui,sans-serif;touch-action:manipulation}button{font:inherit;font-weight:900;color:var(--chalk);background:#214b3d;border:3px solid var(--gold);border-radius:12px;padding:10px 14px;box-shadow:inset 0 -4px #102b22,0 3px #101b16;cursor:pointer}button:active{transform:translateY(2px)}button:disabled{opacity:.45;cursor:not-allowed}#app{position:relative;width:100%;height:100%;overflow:hidden;background:radial-gradient(ellipse at center,#315d4c,var(--board) 65%,#18382f);border:clamp(5px,1vw,13px) solid var(--gold)}#app:after{content:"";position:absolute;inset:6px;border:2px solid #111d18;pointer-events:none;z-index:9}.screen{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:clamp(10px,3vw,30px);text-align:center;overflow:auto}.hidden{display:none!important}h1{font-size:clamp(30px,6vw,68px);line-height:1;margin:0 0 8px;letter-spacing:.04em;text-shadow:2px 2px #ffffff17}h2{font-size:clamp(21px,4vw,36px);margin:0 0 12px}.sub{font-size:clamp(12px,1.6vw,18px);margin:0 0 12px}.primary{background:#2c9950;font-size:clamp(20px,3vw,34px);padding:13px 22px;width:min(82%,420px)}.row{display:flex;justify-content:center;align-items:center;gap:8px;flex-wrap:wrap;margin-top:9px}.small{font-size:12px;padding:8px 10px}.panel{width:min(94%,680px);max-height:92%;overflow:auto;background:#17382e;border:3px solid var(--gold);border-radius:14px;padding:clamp(13px,2.7vw,24px);box-shadow:0 5px #101b16}.panel p{font-size:clamp(12px,1.6vw,16px)}.barOuter{height:25px;padding:3px;border:3px solid var(--gold);border-radius:9px;background:#102d23;width:min(80%,620px)}#bar{width:0;height:100%;background:repeating-linear-gradient(90deg,#43bf58 0 18%,#236e3a 18% 20%);border-radius:4px}#loadText{font-weight:1000;margin:6px}#hud{position:absolute;z-index:3;top:2%;left:2%;right:2%;display:flex;justify-content:space-between;gap:4px;pointer-events:none;font-size:clamp(10px,1.7vw,18px);font-weight:1000;text-shadow:2px 2px #10251e}.hudBox{background:#14372ee8;border:2px solid var(--gold);border-radius:8px;padding:5px 8px}#arena{position:relative;width:min(92%,850px);height:min(52%,430px);min-height:155px;border:4px solid var(--gold);border-radius:14px;overflow:hidden;background-color:#244638;background-image:linear-gradient(#ffffff0b 1px,transparent 1px),linear-gradient(90deg,#ffffff0b 1px,transparent 1px);background-size:30px 30px;flex-shrink:0}.actor{position:absolute;width:clamp(34px,5.5vw,50px);height:clamp(34px,5.5vw,50px);border:3px solid var(--gold);border-radius:12px;display:grid;place-items:center;font-size:clamp(20px,3.5vw,32px);z-index:3;transform:translate(-50%,-50%);user-select:none;filter:drop-shadow(0 3px 1px #10251e)}#player{background:#2c9950}.enemy{background:#b84d48;border-radius:50%;z-index:2}.projectile{position:absolute;z-index:4;width:15px;height:15px;border-radius:50%;background:#fff3a5;border:2px solid #fff8df;box-shadow:0 0 10px #ffdc61;transform:translate(-50%,-50%);pointer-events:none}.pickup{position:absolute;z-index:2;font-size:27px;transform:translate(-50%,-50%);filter:drop-shadow(0 2px 2px #10251e)}#joystick{position:absolute;z-index:5;bottom:4%;left:3%;width:clamp(86px,16vw,130px);height:clamp(86px,16vw,130px);border:3px solid #efd88a99;border-radius:50%;background:#102d2399;touch-action:none;user-select:none;display:none}#stick{position:absolute;left:50%;top:50%;width:42%;height:42%;border-radius:50%;background:#e9d38c;border:3px solid #fff8df;transform:translate(-50%,-50%)}#touchActions{position:absolute;z-index:5;right:3%;bottom:4%;display:none;flex-direction:column;gap:8px}#touchActions button{width:clamp(55px,10vw,76px);height:clamp(55px,10vw,76px);border-radius:50%;padding:3px;font-size:clamp(10px,1.5vw,14px);background:#2c9950e8}#message{min-height:1.4em;margin:6px 0;font-size:clamp(11px,1.5vw,16px);font-weight:900}.shopGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;text-align:left}.item{background:#214b3d;border:2px solid var(--gold);border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:5px}.item .emoji{font-size:28px}.item p{margin:0;font-size:13px}.item button{font-size:12px;padding:8px}.reward{background:#214b3d;border:2px solid var(--gold);border-radius:10px;padding:10px;flex:1;min-width:64px}.reward b{display:block;font-size:22px}#toast{position:absolute;z-index:10;bottom:2%;left:50%;transform:translateX(-50%);max-width:94%;padding:8px 13px;background:#10251ef2;border:2px solid var(--gold);border-radius:9px;display:none;font-weight:900;font-size:13px}@media(pointer:coarse){#joystick,#touchActions{display:flex}}@media(max-width:520px){#arena{width:96%;height:42%;min-height:150px}#hud{left:1%;right:1%;top:1%;gap:3px}.hudBox{padding:4px;font-size:10px}.screen{padding:9px}.shopGrid{grid-template-columns:1fr 1fr}.item{padding:7px}#joystick{width:88px;height:88px}#touchActions button{width:55px;height:55px}}
</style>
