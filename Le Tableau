<body><main id="app">
<section id="loading" class="screen"><h1>LE TABLEAU</h1><p class="sub">CRAIE BATTLE • DELUXE</p><div class="barOuter"><div id="bar"></div></div><div id="loadText">Chargement… 0%</div><p id="loadHint" class="sub">Préparation du jeu…</p></section>
<section id="home" class="screen hidden"><h1>LE TABLEAU</h1><p class="sub">CRAIE BATTLE • SURVIE & COMBAT</p><div class="panel"><p>⚔️ Tire sur les ennemis, esquive-les et ramasse les pièces !</p><p>⭐ Record : <b id="homeBest">0</b> · 🪙 Pièces : <b id="homeCoins">0</b> · Arme : <b id="homeWeapon">Craie simple</b></p></div><button id="play" class="primary" style="margin-top:12px">▶ JOUER</button><div class="row"><button id="shopOpen">🛒 SHOP</button><button id="dailyOpen">🎁 CADEAUX</button><button id="settingsOpen">⚙ OPTIONS</button></div><div class="row"><button id="helpOpen" class="small">? AIDE</button><button id="reset" class="small">↻ RESET SAUVEGARDE</button></div><p class="sub">PC : ZQSD/WASD + Espace ou clic. Mobile : joystick + boutons.</p></section>
<section id="settings" class="screen hidden"><div class="panel"><h2>⚙ OPTIONS</h2><p><label><input id="sound" type="checkbox" checked> Sons activés</label></p><p><label><input id="effects" type="checkbox" checked> Vibrations/effets activés</label></p><p>Volume <input id="volume" type="range" min="0" max="100" value="35"></p><button id="settingsBack">← RETOUR</button></div></section>
<section id="help" class="screen hidden"><div class="panel"><h2>COMMENT JOUER</h2><p>🕹️ Mobile : joystick à gauche, ATTAQUE à droite et ÉCLAT pour éliminer les ennemis proches.</p><p>⌨️ PC : ZQSD/WASD ou flèches pour bouger. Espace/clic pour attaquer, Maj pour ÉCLAT.</p><p>🎯 Les ennemis vaincus rapportent des pièces. Ramasse 🪙 et survis le plus longtemps possible.</p><p>🎁 Un cadeau quotidien. Les données sont enregistrées dans ce navigateur.</p><button id="helpBack">← RETOUR</button></div></section>
<section id="shop" class="screen hidden"><div class="panel"><h2>🛒 SHOP DE CRAIE</h2><p>Solde : 🪙 <b id="shopCoins">0</b></p><div class="shopGrid" id="shopGrid"></div><div class="row"><button id="shopBack">← RETOUR</button></div></div></section>
<section id="daily" class="screen hidden"><div class="panel"><h2>🎁 CADEAUX QUOTIDIENS</h2><p id="dailyStatus"></p><div class="row" id="dailyRow"></div><div class="row"><button id="claimDaily">🎁 RÉCUPÉRER</button><button id="dailyBack">← RETOUR</button></div></div></section>
<section id="game" class="screen hidden"><div id="hud"><div class="hudBox">⭐ <span id="score">0</span></div><div class="hudBox">❤️ <span id="lives">3</span></div><div class="hudBox">⏱ <span id="time">60</span></div><div class="hudBox">🪙 <span id="coins">0</span></div></div><div style="height:10%;flex-shrink:0"></div><h2 style="font-size:clamp(18px,3.2vw,33px);margin:0 0 7px">CRAIE BATTLE !</h2><div id="arena"><div id="player" class="actor">🟢</div></div><div id="message">Appuie sur DÉMARRER pour jouer.</div><div class="row" style="margin-top:0"><button id="start">▶ DÉMARRER</button><button id="pause">Ⅱ PAUSE</button><button id="gameMenu" class="small">⌂ MENU</button></div><div id="joystick"><div id="stick"></div></div><div id="touchActions"><button id="attackBtn">🎯<br>ATTAQUE</button><button id="dashBtn">💥<br>ÉCLAT</button></div></section>
<section id="result" class="screen hidden"><div class="panel"><h2>FIN DE PARTIE !</h2><p>Score : <b id="finalScore">0</b> ⭐</p><p>Ennemis vaincus : <b id="finalKills">0</b></p><p>Pièces gagnées : <b id="finalEarned">0</b> 🪙</p><p id="resultText"></p><div class="row"><button id="again">↻ REJOUER</button><button id="resultShop">🛒 SHOP</button><button id="resultMenu">⌂ MENU</button></div></div></section><div id="toast" role="status" aria-live="polite"></div>
</main>
<script>
(()=>{'use strict';const $=s=>document.querySelector(s),ids=['#loading','#home','#settings','#help','#shop','#daily','#game','#result'];
const defaults={best:0,coins:0,weapon:'chalk',owned:['chalk'],sound:true,effects:true,volume:35,lastDaily:'',dailyStreak:0};let save={...defaults};try{save={...defaults,...JSON.parse(localStorage.getItem('chalkBattleSave')||'{}')};if(!Array.isArray(save.owned))save.owned=['chalk']}catch(e){}
let score=0,lives=3,time=60,kills=0,earned=0,playing=false,paused=false,raf=0,last=0,sec=0,spawn=0,enemySpawn=0,stars=[],enemies=[],shots=[],keys={},joy={x:0,y:0},joyPointer=null,joyActive=false,pos={x:.5,y:.62},attackAt=0,dashCooldown=0,audio=null,toastTimer=0;
const weapons=[{id:'chalk',name:'Craie simple',emoji:'🖍️',price:0,damage:1,rate:380,desc:'Arme de départ.'},{id:'marker',name:'Marqueur turbo',emoji:'🖊️',price:80,damage:1,rate:210,desc:'Tire plus vite.'},{id:'gold',name:'Craie dorée',emoji:'✨',price:180,damage:2,rate:380,desc:'Deux fois plus puissante.'},{id:'rainbow',name:'Craie arc-en-ciel',emoji:'🌈',price:350,damage:2,rate:240,desc:'Puissante et rapide.'}];
function persist(){try{localStorage.setItem('chalkBattleSave',JSON.stringify(save))}catch(e){toast('Sauvegarde impossible dans ce navigateur')}}
function toast(t){$('#toast').textContent=t;$('#toast').style.display='block';clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('#toast').style.display='none',2200)}
function show(id){ids.forEach(s=>$(s).classList.toggle('hidden',s!==id));if(id==='#home')refreshHome();if(id==='#shop')renderShop();if(id==='#daily')renderDaily()}
function weapon(){return weapons.find(w=>w.id===save.weapon)||weapons[0]}function refreshHome(){$('#homeBest').textContent=save.best;$('#homeCoins').textContent=save.coins;$('#homeWeapon').textContent=weapon().name;$('#coins').textContent=save.coins}
function beep(f=550,d=.08,w='sine'){if(!save.sound||save.volume<=0)return;try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;if(!audio)audio=new AC();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type=w;o.frequency.value=f;g.gain.setValueAtTime(save.volume/100*.13,audio.currentTime);g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+d);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+d)}catch(e){}}
function buzz(){if(save.effects&&navigator.vibrate)navigator.vibrate(25)}function rand(a,b){return a+Math.random()*(b-a)}function ar(){return{w:$('#arena').clientWidth,h:$('#arena').clientHeight}}
function create(type,x=rand(.08,.92),y=rand(.08,.92)){const el=document.createElement('div');el.className=type==='enemy'?'actor enemy':'pickup';el.textContent=type==='enemy'?'👾':type==='coin'?'🪙':'⭐';$('#arena').appendChild(el);const o={el,type,x,y,hp:type==='enemy'?2:1};place(o);(type==='enemy'?enemies:stars).push(o);return o}
function place(o){o.el.style.left=o.x*100+'%';o.el.style.top=o.y*100+'%'}function clearArena(){[...stars,...enemies,...shots].forEach(o=>o.el.remove());stars=[];enemies=[];shots=[]}function movePlayer(){$('#player').style.left=pos.x*100+'%';$('#player').style.top=pos.y*100+'%'}function hud(){$('#score').textContent=score;$('#lives').textContent=lives;$('#time').textContent=time;$('#coins').textContent=save.coins}
function startGame(){cancelAnimationFrame(raf);clearArena();score=0;lives=3;time=60;kills=0;earned=0;playing=true;paused=false;attackAt=0;dashCooldown=0;spawn=0;enemySpawn=0;pos={x:.5,y:.62};movePlayer();$('#start').textContent='↻ RECOMMENCER';$('#pause').textContent='Ⅱ PAUSE';$('#message').textContent='Attaque les ennemis et ramasse les pièces !';create('star');create('star');create('enemy');hud();last=sec=performance.now();beep(650,.12);raf=requestAnimationFrame(frame)}
function endGame(){if(!playing)return;playing=false;paused=false;cancelAnimationFrame(raf);clearArena();const old=save.best;save.best=Math.max(save.best,score);save.coins+=earned;persist();$('#finalScore').textContent=score;$('#finalKills').textContent=kills;$('#finalEarned').textContent=earned;$('#resultText').textContent=score>old?'🏆 Nouveau record sauvegardé !':'Record actuel : '+save.best;hud();show('#result');beep(420,.15);setTimeout(()=>beep(620,.18),150)}
function fire(){if(!playing||paused)return;const w=weapon(),now=performance.now();if(now-attackAt<w.rate)return;attackAt=now;const a=ar(),target=enemies.slice().sort((x,y)=>Math.hypot((x.x-pos.x)*a.w,(x.y-pos.y)*a.h)-Math.hypot((y.x-pos.x)*a.w,(y.y-pos.y)*a.h))[0];let dx=target?target.x-pos.x:1,dy=target?target.y-pos.y:0,m=Math.hypot(dx,dy)||1;const el=document.createElement('div');el.className='projectile';$('#arena').appendChild(el);shots.push({el,x:pos.x,y:pos.y,vx:dx/m,vy:dy/m,damage:w.damage,life:1.3});beep(w.id==='gold'?850:620,.045,'square')}
function dash(){if(!playing||paused)return;if(dashCooldown>0){toast('Éclat en recharge !');return}dashCooldown=4;const a=ar();enemies.slice().forEach(e=>{if(Math.hypot((e.x-pos.x)*a.w,(e.y-pos.y)*a.h)<a.w*.36){e.el.remove();enemies=enemies.filter(v=>v!==e);score+=5;kills++;earned+=2}});$('#message').textContent='💥 ÉCLAT ! Ennemis proches éliminés';beep(190,.18,'sawtooth');buzz();hud()}
function frame(now){if(!playing)return;raf=requestAnimationFrame(frame);if(paused){last=now;sec=now;return}const dt=Math.min((now-last)/1000,.045);last=now;if(now-sec>=1000){time--;sec=now;$('#time').textContent=time;if(time<=0){endGame();return}}spawn+=dt;enemySpawn+=dt;if(spawn>1.5){spawn=0;if(stars.length<4)create(Math.random()<.35?'coin':'star')}if(enemySpawn>2.5){enemySpawn=0;if(enemies.length<5)create('enemy')}
const a=ar();let dx=joy.x,dy=joy.y;if(keys.ArrowLeft||keys.q||keys.Q||keys.a||keys.A)dx--;if(keys.ArrowRight||keys.d||keys.D)dx++;if(keys.ArrowUp||keys.z||keys.Z||keys.w||keys.W)dy--;if(keys.ArrowDown||keys.s||keys.S)dy++;let m=Math.hypot(dx,dy);if(m>1){dx/=m;dy/=m}pos.x=Math.max(.035,Math.min(.965,pos.x+dx*dt*.34));pos.y=Math.max(.07,Math.min(.93,pos.y+dy*dt*.34));movePlayer();
stars.slice().forEach(o=>{if(Math.hypot((o.x-pos.x)*a.w,(o.y-pos.y)*a.h)<29){o.el.remove();stars=stars.filter(v=>v!==o);if(o.type==='coin'){earned+=5;score+=5;beep(980,.08)}else{score+=10;earned++;beep(740,.07)}$('#message').textContent=o.type==='coin'?'+5 pièces !':'+10 points !';hud()}});
enemies.slice().forEach(o=>{let x=pos.x-o.x,y=pos.y-o.y,d=Math.hypot(x,y)||1;o.x+=x/d*dt*.075;o.y+=y/d*dt*.075;place(o);if(Math.hypot(x*a.w,y*a.h)<31){o.el.remove();enemies=enemies.filter(v=>v!==o);lives--;$('#message').textContent='Touché ! Éloigne-toi !';beep(150,.15,'sawtooth');buzz();hud();if(lives<=0)endGame()}});
shots.slice().forEach(s=>{s.x+=s.vx*dt*.9;s.y+=s.vy*dt*.9;s.life-=dt;place(s);let hit=enemies.find(e=>Math.hypot((e.x-s.x)*a.w,(e.y-s.y)*a.h)<27);if(hit){hit.hp-=s.damage;s.el.remove();shots=shots.filter(v=>v!==s);if(hit.hp<=0){hit.el.remove();enemies=enemies.filter(v=>v!==hit);score+=15;kills++;earned+=4;$('#message').textContent='🎯 Ennemi vaincu ! +4 pièces';beep(390,.06);setTimeout(()=>beep(780,.08),45);hud()}else beep(260,.04)}else if(s.life<=0||s.x<0||s.x>1||s.y<0||s.y>1){s.el.remove();shots=shots.filter(v=>v!==s)}})}
function renderShop(){$('#shopCoins').textContent=save.coins;const grid=$('#shopGrid');grid.innerHTML='';weapons.forEach(w=>{let owned=save.owned.includes(w.id),equipped=save.weapon===w.id;const c=document.createElement('div');c.className='item';c.innerHTML=`<div class="emoji">${w.emoji}</div><strong>${w.name}</strong><p>${w.desc}</p><p>Prix : ${w.price===0?'Gratuit':w.price+' 🪙'}</p>`;const b=document.createElement('button');b.textContent=equipped?'✓ ÉQUIPÉ':owned?'ÉQUIPER':`ACHETER · ${w.price} 🪙`;b.disabled=equipped;b.onclick=()=>{if(!owned){if(save.coins<w.price){toast('Pas assez de pièces !');beep(170,.1);return}save.coins-=w.price;save.owned.push(w.id);beep(700,.1);toast('Arme achetée !')}save.weapon=w.id;persist();renderShop();refreshHome()};c.appendChild(b);grid.appendChild(c)})}
function dateKey(d=new Date()){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}function renderDaily(){let claimed=save.lastDaily===dateKey();$('#dailyStatus').textContent=claimed?'✅ Cadeau déjà récupéré aujourd’hui. Reviens demain !':'🎁 Ton cadeau du jour t’attend !';$('#dailyRow').innerHTML='';[25,40,60,85,120,160,250].forEach((n,i)=>{let d=document.createElement('div');d.className='reward';d.innerHTML=`<b>${['🪙','🎁','⭐','🪙','✨','🎁','🏆'][i]}</b>Jour ${i+1}<br><strong>${n} pièces</strong>`;$('#dailyRow').appendChild(d)});$('#claimDaily').disabled=claimed}
function claimDaily(){if(save.lastDaily===dateKey()){toast('Cadeau déjà récupéré !');return}let y=new Date();y.setDate(y.getDate()-1);save.dailyStreak=save.lastDaily===dateKey(y)?save.dailyStreak%7+1:1;let reward=[25,40,60,85,120,160,250][save.dailyStreak-1];save.coins+=reward;save.lastDaily=dateKey();persist();renderDaily();refreshHome();beep(800,.13);setTimeout(()=>beep(1000,.15),100);toast('🎁 +'+reward+' pièces !')}
$('#play').onclick=()=>{show('#game');$('#message').textContent='Appuie sur DÉMARRER pour lancer le combat.'};$('#shopOpen').onclick=()=>show('#shop');$('#dailyOpen').onclick=()=>show('#daily');$('#settingsOpen').onclick=()=>show('#settings');$('#helpOpen').onclick=()=>show('#help');$('#settingsBack').onclick=$('#helpBack').onclick=$('#shopBack').onclick=$('#dailyBack').onclick=()=>show('#home');$('#claimDaily').onclick=claimDaily;
$('#sound').onchange=e=>{save.sound=e.target.checked;persist();beep(600,.07)};$('#effects').onchange=e=>{save.effects=e.target.checked;persist()};$('#volume').oninput=e=>{save.volume=+e.target.value;persist()};function sync(){$('#sound').checked=save.sound;$('#effects').checked=save.effects;$('#volume').value=save.volume}
$('#start').onclick=startGame;$('#attackBtn').onclick=fire;$('#dashBtn').onclick=dash;$('#pause').onclick=()=>{if(!playing)return;paused=!paused;$('#pause').textContent=paused?'▶ REPRENDRE':'Ⅱ PAUSE';$('#message').textContent=paused?'Partie en pause':'Combat !';beep(paused?300:600,.07)};$('#gameMenu').onclick=()=>{playing=false;cancelAnimationFrame(raf);clearArena();show('#home')};$('#again').onclick=()=>{show('#game');startGame()};$('#resultMenu').onclick=()=>show('#home');$('#resultShop').onclick=()=>show('#shop');$('#reset').onclick=()=>{if(confirm('Effacer pièces, armes, record et cadeau quotidien ?')){save={...defaults,owned:['chalk']};persist();sync();refreshHome();toast('Sauvegarde réinitialisée')}};
$('#arena').addEventListener('pointerdown',e=>{if(e.target===$('#arena')||e.target===$('#player'))fire()});window.addEventListener('keydown',e=>{if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();keys[e.key]=true;if(!e.repeat&&e.key===' ')fire();if(!e.repeat&&e.key==='Shift')dash()});window.addEventListener('keyup',e=>keys[e.key]=false);window.addEventListener('blur',()=>{keys={};joy={x:0,y:0}});
const je=$('#joystick'),stick=$('#stick');function joyMove(e){const r=je.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;let x=(e.clientX-cx)/(r.width*.34),y=(e.clientY-cy)/(r.height*.34),m=Math.hypot(x,y);if(m>1){x/=m;y/=m}joy={x,y};stick.style.left=50+x*34+'%';stick.style.top=50+y*34+'%'}je.onpointerdown=e=>{e.preventDefault();joyActive=true;joyPointer=e.pointerId;je.setPointerCapture(e.pointerId);joyMove(e)};je.onpointermove=e=>{if(joyActive&&e.pointerId===joyPointer)joyMove(e)};function joyEnd(e){if(e.pointerId!==joyPointer)return;joyActive=false;joyPointer=null;joy={x:0,y:0};stick.style.left=stick.style.top='50%'}je.onpointerup=joyEnd;je.onpointercancel=joyEnd;
sync();refreshHome();let pct=0;const stages=['Initialisation du tableau…','Chargement des armes…','Préparation des sons…','Récupération de la sauvegarde…','Prêt !'];const load=setInterval(()=>{pct=Math.min(100,pct+Math.floor(Math.random()*9)+4);$('#bar').style.width=pct+'%';$('#loadText').textContent='Chargement… '+pct+'%';$('#loadHint').textContent=stages[Math.min(4,Math.floor(pct/21))];if(pct>=100){clearInterval(load);setTimeout(()=>show('#home'),250)}},110);
})();
</script></body></html>
